{
 "collection": "products",
 "pipeline": [
  {
   "$vectorSearch": {
    "index": "product_vectors",
    "path": "embedding",
    "queryVector": [
     0.1,
     -0.2,
     0.3,
     0.05,
     -0.4,
     0.2,
     0.0,
     0.1
    ],
    "numCandidates": 10,
    "limit": 10
   }
  },
  {
   "$match": {
    "category": "shoes"
   }
  },
  {
   "$project": {
    "sku": 1,
    "category": 1,
    "score": {
     "$meta": "vectorSearchScore"
    }
   }
  }
 ]
}
